# Quant Opportunity Engine — Environment Configuration
# ====================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# --- Mode ---
# "paper" or "live"
# LIVE TRADING IS DISABLED BY DEFAULT.
# You must set LIVE_TRADING_ENABLED=true explicitly AND set MODE=live.
MODE=paper
LIVE_TRADING_ENABLED=false

# --- Database ---
DATABASE_URL=postgresql+asyncpg://bot:bot_password@localhost:5432/bot_db
DATABASE_URL_SYNC=postgresql://bot:bot_password@localhost:5432/bot_db
REDIS_URL=redis://localhost:6379/0

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Exchange API Keys (paper/testing) ---
# Coinbase / Advanced Trade
COINBASE_API_KEY=
COINBASE_API_SECRET=

# Binance
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Kraken
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Bybit
BYBIT_API_KEY=
BYBIT_API_SECRET=

# --- Security ---
# NEVER set withdrawal permissions on API keys.
# Trading-only keys are mandatory.
API_KEY_READ_ONLY=false

# --- Risk Limits (overridable per config) ---
MAX_POSITION_SIZE_USD=1000.0
MAX_TOTAL_EXPOSURE_USD=10000.0
MAX_DRAWDOWN_PCT=10.0
DEFAULT_STOP_LOSS_PCT=0.3
MAX_LEVERAGE=1.0

# --- Alerts ---
# Telegram / Discord / Email webhooks (optional)
ALERT_WEBHOOK_URL=
ALERT_EMAIL=

# --- Dashboard ---
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
