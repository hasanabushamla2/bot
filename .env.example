# Monitoring Dashboard Configuration
# Do not expose real credentials here.

# Backend API URL (for dashboard frontend)
API_URL=http://localhost:8000

# Paper trading database path (for API backend)
PAPER_DB_PATH=data/paper_trading.db

# Paper execution/risk protections (defaults shown)
LOSS_COOLDOWN_SECONDS=300
WIN_COOLDOWN_SECONDS=30
TRAIL_ACTIVATION_PCT=0.20
TRAIL_DISTANCE_PCT=0.20
TRAIL_VOLATILITY_MULTIPLIER=1.50
TRAIL_SPREAD_MULTIPLIER=2.00
TRAIL_ACTIVATION_VOLATILITY_MULTIPLIER=1.25
MAX_TRAIL_DISTANCE_PCT=1.25
MATERIAL_REENTRY_CONFIDENCE_IMPROVEMENT=0.10
MIN_REENTRY_MARKET_STRUCTURE_SCORE=0.55
REENTRY_REFERENCE_VOLATILITY_PCT=0.30
MAX_CONSECUTIVE_LOSSES_PER_SYMBOL=2
SYMBOL_LOCKOUT_SECONDS=1800
SYMBOL_LOSS_STREAK_RESET_SECONDS=21600
MIN_EXPECTED_EDGE_OVER_COST=0.001

# Bounded high-conviction sizing. These can use up to the existing per-position
# cap; they do not raise leverage, total exposure, or the configured max size.
HIGH_CONVICTION_SIZING_ENABLED=true
HIGH_CONVICTION_MIN_CONFIDENCE=0.72
HIGH_CONVICTION_MIN_QUALITY_SCORE=0.70
HIGH_CONVICTION_MIN_NET_EDGE_FRACTION=0.0015
HIGH_CONVICTION_MAX_MULTIPLIER=4.0

# Realistic paper fill model; use the same values at every soak stage.
PAPER_TAKER_FEE=0.001
PAPER_MAKER_FEE=0.001
PAPER_SLIPPAGE_BPS=5.0
PAPER_SIMULATED_LATENCY_MS=50.0

# The live-paper runner defaults to --profile aggressive-paper. This remains
# simulation-only: it can deploy up to 100% across diversified positions but
# cannot place real orders. Use --profile safe for the conservative allocator.
